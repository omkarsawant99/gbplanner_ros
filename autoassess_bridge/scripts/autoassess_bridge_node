#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-3-Clause
"""Follow the newest Ready AutoAssess plan in CDF and publish it (latched) for the autonomy stack.

Without ~vessel_external_id / ~area_external_id it follows the newest Ready plan of the whole
project; the plan's area then drives everything else (global bound, map, upload area).

Publishes /autoassess/plan (std_msgs/String, plan.json text as written by `dss plan download`),
/autoassess/inspection_targets (geometry_msgs/PoseArray, one inspection pose per task) and
/autoassess/plan_id (std_msgs/String). With ~publish_map (default true) it also publishes the
plan's reference map (a point cloud of the plan's map campaign, cached locally) latched on
~map_topic (default /ballast_tank/pointcloud), like `pcl_ros pcd_to_pointcloud` did.
Optionally sends the area box to gbplanner's set_global_bound service.
Credentials come from COGNITE_* env variables.

Findings from the detection stack arrive as JSON on /autoassess/findings (always subscribed,
buffered per mission). With ~upload_enabled (default false) the node writes the mission to CDF
(its only writes): the gbplanner mesh plus the ~mission_dir files as CogniteFiles, an
AutoAssess campaign that lists them, and one DefectDetection node per (merged) finding on that
campaign (~submit_findings retries just the defects). An upload runs on the ~upload_mission service
(std_srvs/Trigger) and, with ~upload_on_mission_end, when the mission looks finished
(homing, no new path for ~mission_end_quiet_s, robot still). Progress: /autoassess/upload_status.
"""

import json
import os
import sys
import threading
import time

import rospy
from geometry_msgs.msg import Point, Pose, PoseArray, Quaternion
from nav_msgs.msg import Odometry, Path
from sensor_msgs.msg import PointCloud2, PointField
from planner_msgs.msg import PlanningBound
from planner_msgs.srv import planner_set_global_bound, planner_set_global_boundRequest
from std_msgs.msg import Bool, String
from std_srvs.srv import Empty, Trigger, TriggerResponse

from autoassess_bridge import cdf
from autoassess_bridge.bound import GlobalBoundSetter, ServiceUnavailable
from autoassess_bridge.env_file import load_credentials
from autoassess_bridge.findings import FindingsBuffer, parse_findings_json
from autoassess_bridge.map import DEFAULT_CACHE_DIR, MapSource, MapUpdater
from autoassess_bridge.mission_end import MissionEndDetector
from autoassess_bridge.plan import area_bounds, plan_to_poses
from autoassess_bridge.poller import PlanPoller
from autoassess_bridge.upload import (
    DefectService,
    FollowedPlans,
    MissionContext,
    MissionFlow,
    MissionUploader,
    MissionUploadRunner,
    export_mesh,
    mission_id_for,
    status_message,
)


class RosLog:
    info = staticmethod(rospy.loginfo)
    warning = staticmethod(rospy.logwarn)
    error = staticmethod(rospy.logerr)


def make_bound_call(service_name, timeout_s):
    proxy = rospy.ServiceProxy(service_name, planner_set_global_bound)

    def call(bounds):
        try:
            rospy.wait_for_service(service_name, timeout=timeout_s)
        except rospy.ROSException as exc:
            raise ServiceUnavailable("{}: {}".format(service_name, exc))
        (lo, hi) = bounds
        req = planner_set_global_boundRequest()
        req.get_current_bound = False
        req.reset_to_default = False
        req.bound = PlanningBound(use_z_val=True, min_val=Point(*lo), max_val=Point(*hi))
        res = proxy(req)
        ret = res.bound_ret
        detail = "min [{:.2f}, {:.2f}, {:.2f}] max [{:.2f}, {:.2f}, {:.2f}]".format(
            ret.min_val.x, ret.min_val.y, ret.min_val.z, ret.max_val.x, ret.max_val.y, ret.max_val.z
        )
        return bool(res.success), detail

    return call


def make_mesh_export(service_name, mesh_filename, service_timeout_s, mesh_timeout_s):
    """export_mesh() for the runner: call voxblox's generate_mesh, wait for the PLY file."""
    proxy = rospy.ServiceProxy(service_name, Empty)

    def generate():
        rospy.wait_for_service(service_name, timeout=service_timeout_s)
        proxy()

    return lambda: export_mesh(generate, mesh_filename, mesh_timeout_s)


class FindingsListener:
    """Buffers /autoassess/findings. Always on, so misconfiguration stays visible."""

    def __init__(self, buffer, upload_enabled):
        self._buffer = buffer
        self._upload_enabled = upload_enabled
        self._warned_disabled = False
        self._logged_errors = set()
        rospy.Subscriber("/autoassess/findings", String, self._on_findings)

    def _on_findings(self, msg):
        findings, errors = parse_findings_json(msg.data)
        added = sum(1 for finding in findings if self._buffer.add(finding))
        for error in errors:
            if error not in self._logged_errors and len(self._logged_errors) < 200:
                self._logged_errors.add(error)
                rospy.logwarn("Bad finding skipped: %s", error)
        if added:
            rospy.loginfo("Buffered %d finding(s), %d in total", added, len(self._buffer))
        if not self._upload_enabled and not self._warned_disabled and (findings or errors):
            self._warned_disabled = True
            rospy.logwarn(
                "Findings received but ~upload_enabled is false: no defects will be stored"
            )
        if self._buffer.dropped:
            rospy.logwarn_throttle(60, "Findings buffer full: %d dropped", self._buffer.dropped)


class MissionUploads:
    """ROS wiring around MissionUploadRunner: status topic, Trigger service, auto trigger."""

    def __init__(self, client, space, followed, findings_buffer, configured_area):
        self._followed = followed  # FollowedPlans: the plan (and area and map) followed when
        self._configured_area = configured_area  # enables campaign-less first-mapping uploads
        self._last_failed = None
        self._last_ctx = None  # the last mission ctx, for ~submit_findings after a failure
        self._status_pub = rospy.Publisher("/autoassess/upload_status", String, queue_size=1, latch=True)
        mesh_filename = rospy.get_param("~mesh_filename", "")
        mission_dir = rospy.get_param("~mission_dir", "") or None
        exporter = None
        if mesh_filename:
            exporter = make_mesh_export(
                rospy.get_param("~generate_mesh_service", "/gbplanner_node/generate_mesh"),
                mesh_filename,
                float(rospy.get_param("~service_timeout_s", 5.0)),
                float(rospy.get_param("~mesh_timeout_s", 30.0)),
            )
        else:
            rospy.logwarn("~mesh_filename is empty: uploads contain only the ~mission_dir files")
        defect_service = DefectService(
            client,
            RosLog(),
            space=space,
            merge_radius_m=float(rospy.get_param("~findings_merge_radius_m", 0.5)),
        )
        self._flow = MissionFlow(None, defect_service, findings_buffer, self._publish, RosLog())
        self._flow.bind(
            MissionUploadRunner(
                MissionUploader(client, RosLog(), space=space),
                export_mesh=exporter,
                mission_dir=mission_dir,
                publish_status=self._flow.runner_publish_status,
                log=RosLog(),
            )
        )
        self._detector = None
        if bool(rospy.get_param("~upload_on_mission_end", True)):
            self._detector = MissionEndDetector(
                quiet_s=float(rospy.get_param("~mission_end_quiet_s", 10.0)),
                max_speed=float(rospy.get_param("~mission_end_max_speed", 0.1)),
            )
            rospy.Subscriber(rospy.get_param("~path_topic", "/gbplanner_path"), Path, self._on_path)
            rospy.Subscriber(rospy.get_param("~homing_topic", "/gbplanner_is_homing"), Bool, self._on_homing)
            rospy.Subscriber("odometry", Odometry, self._on_odometry)
        rospy.Service("~upload_mission", Trigger, self._on_trigger)
        rospy.Service("~submit_findings", Trigger, self._on_submit_findings)
        self._publish(status_message("idle", None))
        rospy.loginfo(
            "Mission upload enabled (%s)",
            "on mission end and ~upload_mission" if self._detector else "on ~upload_mission only",
        )

    def tick(self):
        if self._detector is None:
            return
        started_at = self._detector.check(time.time())
        if started_at is not None:
            rospy.loginfo("Mission looks finished (homing, no new path, robot still): uploading")
            ctx = self._context(started_at)
            threading.Thread(target=self._run, args=(ctx,), daemon=True).start()

    def _run(self, ctx):
        if ctx is not None:
            self._last_ctx = ctx
        ok, _message = self._flow.run(ctx)
        self._last_failed = None if ok else ctx
        return ok, _message

    def _on_submit_findings(self, _req):
        ctx = self._last_ctx or self._context(time.time())
        ok, message = self._flow.submit_findings(ctx)
        return TriggerResponse(success=ok, message=message)

    def _on_trigger(self, _req):
        started_at = self._detector.mission_started_at if self._detector else None
        if started_at is not None:
            ctx = self._context(started_at)
        elif self._last_failed is not None:
            ctx = self._last_failed  # resume: same mission id, same campaign, skip uploaded files
        else:
            ctx = self._context(time.time())
        ok, message = self._run(ctx)
        if ok and self._detector is not None:
            self._detector.reset()
        return TriggerResponse(success=ok, message=message)

    def _context(self, started_at):
        """The mission's context: the plan followed at its start, else (with a configured
        ~area_external_id) a campaign-less first-mapping upload, else None."""
        followed = self._followed.at(started_at)
        if followed is None:
            if self._configured_area:
                return MissionContext(
                    self._configured_area,
                    mission_id_for(started_at),
                    None,
                    first_mapping=True,
                )
            return None
        return MissionContext(
            followed.area_external_id,
            mission_id_for(started_at),
            followed.plan_external_id,
            map_external_id=followed.map_external_id,
            plan_name=followed.name,
        )

    def _publish(self, status):
        self._status_pub.publish(String(data=json.dumps(status)))

    def _on_path(self, msg):
        if msg.poses:
            self._detector.on_path(time.time())

    def _on_homing(self, msg):
        self._detector.on_homing(msg.data, time.time())

    def _on_odometry(self, msg):
        v = msg.twist.twist.linear
        self._detector.on_speed((v.x * v.x + v.y * v.y + v.z * v.z) ** 0.5, time.time())


def make_map_publisher(topic, frame_id, rate_hz):
    pub = rospy.Publisher(topic, PointCloud2, queue_size=1, latch=True)
    lock = threading.Lock()
    latest = [None]

    def republish(_event=None):
        with lock:
            if latest[0] is None:
                return
            latest[0].header.stamp = rospy.Time.now()
            pub.publish(latest[0])

    def publish(_map_id, _map_file, cloud):
        msg = PointCloud2()
        msg.header.frame_id = frame_id
        msg.height = cloud.height
        msg.width = cloud.width
        msg.fields = [
            PointField(name=f.name, offset=f.offset, datatype=f.datatype, count=f.count)
            for f in cloud.fields
        ]
        msg.is_bigendian = False
        msg.point_step = cloud.point_step
        msg.row_step = cloud.point_step * cloud.width
        msg.data = cloud.data
        msg.is_dense = cloud.is_dense
        with lock:
            latest[0] = msg
        republish()

    publish.timer = rospy.Timer(rospy.Duration(1.0 / rate_hz), republish) if rate_hz > 0 else None
    return publish


def to_pose_array(poses, frame_id):
    msg = PoseArray()
    msg.header.frame_id = frame_id
    msg.header.stamp = rospy.Time.now()
    msg.poses = [Pose(position=Point(*p), orientation=Quaternion(*q)) for p, q in poses]
    return msg


def main():
    rospy.init_node("autoassess_bridge")
    area = rospy.get_param("~area_external_id", "") or None
    vessel = rospy.get_param("~vessel_external_id", "") or None
    period_s = float(rospy.get_param("~poll_period_s", 10.0))
    frame_id = rospy.get_param("~frame_id", "world")
    standoff_m = float(rospy.get_param("~standoff_m", 0.8))
    set_bound = bool(rospy.get_param("~set_global_bound", True))
    margin_m = float(rospy.get_param("~bound_margin_m", 0.3))
    service_name = rospy.get_param("~global_bound_service", "gbplanner/set_global_bound")
    timeout_s = float(rospy.get_param("~service_timeout_s", 5.0))
    space = rospy.get_param("~space", cdf.SPACE)

    try:
        credentials_file = rospy.get_param("~credentials_file", "")
        if credentials_file:
            load_credentials(credentials_file, os.environ)
        client = cdf.make_client(os.environ)
    except (OSError, ValueError) as exc:
        rospy.logfatal(str(exc))
        return 1

    log = RosLog()
    poller = PlanPoller(
        cdf.PlanSource(client, space=space), log, area_external_id=area, vessel_external_id=vessel
    )
    bound = GlobalBoundSetter(make_bound_call(service_name, timeout_s), log) if set_bound else None
    plan_pub = rospy.Publisher("/autoassess/plan", String, queue_size=1, latch=True)
    targets_pub = rospy.Publisher("/autoassess/inspection_targets", PoseArray, queue_size=1, latch=True)
    plan_id_pub = rospy.Publisher("/autoassess/plan_id", String, queue_size=1, latch=True)
    rospy.loginfo(
        "Following the newest Ready AutoAssess plan (filter: %s), polling every %.1f s",
        poller.filter_description, period_s,
    )

    maps = None
    if bool(rospy.get_param("~publish_map", True)):
        map_topic = rospy.get_param("~map_topic", "/ballast_tank/pointcloud")
        maps = MapUpdater(
            MapSource(client, rospy.get_param("~map_cache_dir", DEFAULT_CACHE_DIR), log, space=space),
            rospy.get_param("~map_file_label", "") or None,
            make_map_publisher(
                map_topic,
                rospy.get_param("~map_frame_id", "") or frame_id,
                float(rospy.get_param("~map_publish_rate_hz", 1.0)),
            ),
            log,
            retry_s=max(period_s, 30.0),
        )
        rospy.loginfo("Publishing the plan's reference map on %s", map_topic)

    followed = FollowedPlans()
    upload_enabled = bool(rospy.get_param("~upload_enabled", False))
    findings_buffer = FindingsBuffer()
    FindingsListener(findings_buffer, upload_enabled)
    uploads = None
    if upload_enabled:
        uploads = MissionUploads(client, space, followed, findings_buffer, area)

    rate = rospy.Rate(1.0)
    next_poll = 0.0
    while not rospy.is_shutdown():
        if uploads is not None:
            uploads.tick()
        if maps is not None:
            maps.tick(time.time())
        if time.time() < next_poll:
            try:
                rate.sleep()
            except rospy.ROSInterruptException:
                break
            continue
        next_poll = time.time() + period_s
        update = poller.poll()
        if update is not None:
            followed.record(
                time.time(),
                update.plan["planExternalId"],
                update.area.external_id,
                map_external_id=update.plan.get("mapExternalId"),
                name=update.plan.get("name"),
            )
            poses, skipped = plan_to_poses(update.plan, standoff_m)
            plan_pub.publish(String(data=cdf.dumps_plan(update.plan)))
            targets_pub.publish(to_pose_array(poses, frame_id))
            plan_id_pub.publish(String(data=update.plan["planExternalId"]))
            rospy.loginfo(
                "Published plan %s: %d tasks, %d targets",
                update.plan["planExternalId"], len(update.plan["tasks"]), len(poses),
            )
            if skipped:
                rospy.logwarn("Tasks without a target (no pose published): %s", ", ".join(skipped))
            if maps is not None:
                maps.want(update.plan.get("mapExternalId"))
                maps.tick(time.time())  # start the background load before the bound call waits
            if bound is not None:
                box = area_bounds(update.element_centres, margin_m)
                if box is None:
                    rospy.logwarn("Area has no structural elements; global bound not changed")
                else:
                    bound.set_pending(box)
        if bound is not None:
            bound.tick()
        try:
            rate.sleep()
        except rospy.ROSInterruptException:
            break
    return 0


if __name__ == "__main__":
    sys.exit(main())
