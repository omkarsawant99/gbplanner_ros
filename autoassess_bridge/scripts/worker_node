#!/usr/bin/env python3
# SPDX-License-Identifier: BSD-3-Clause
"""Thin exec wrapper that runs the AutoAssess `dss worker` under roslaunch.

roslaunch cannot start an arbitrary command line directly, so autoassess_full.launch starts
this script with the worker command as its args. It strips ROS remapping args (name:=value),
checks the command, and execs it — no supervision here: `dss worker` loops and survives tick
failures itself, and roslaunch's respawn="true" restarts it if it exits.

The command must contain `--area <id>`: an unfiltered worker would build a 3D model for every
model-less mesh in the whole CDF project.
"""

import os
import sys


def main(argv):
    command = [arg for arg in argv if ":=" not in arg and arg != "--wait"]
    if not command:
        sys.stderr.write("worker_node: no worker command given\n")
        return 2
    if not _has_area(command):
        sys.stderr.write(
            "worker_node: refusing to start {!r}: the command must contain '--area <id>' "
            "(pass area_external_id:=... to autoassess_full.launch). An unfiltered worker "
            "would build 3D models for the whole project.\n".format(" ".join(command))
        )
        return 2
    sys.stderr.write("worker_node: exec {}\n".format(" ".join(command)))
    sys.stderr.flush()
    try:
        os.execvp(command[0], command)
    except OSError as exc:
        sys.stderr.write(
            "worker_node: cannot exec {!r}: {} (is uv installed and on PATH, or pass uv:=/abs/path)\n".format(
                command[0], exc
            )
        )
        return 2


def _has_area(command):
    for i, arg in enumerate(command):
        if arg == "--area" and i + 1 < len(command) and command[i + 1].strip():
            return True
        if arg.startswith("--area=") and arg[len("--area="):].strip():
            return True
    return False


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
