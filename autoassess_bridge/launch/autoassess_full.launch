<?xml version="1.0"?>
<!-- SPDX-License-Identifier: BSD-3-Clause -->
<!-- The full AutoAssess loop: the bridge plus the `dss worker` that builds 3D models for
     uploaded meshes. CDF credentials come from the COGNITE_* environment of this launch.

     Required args:
       uidss_dir         checkout of the AutoAssess SDK (the folder with its pyproject.toml);
                         run `uv sync` there once before the first launch (see the README)
       area_external_id  the worker builds models ONLY for this area's meshes (mandatory:
                         an unfiltered worker would build for the whole project). It also
                         restricts which Ready plan the bridge follows.
     Optional:
       uv                absolute path to the uv binary (systemd services often have no PATH)
       worker_command    full override of the worker command (must contain "- -area <id>")
-->
<launch>
  <arg name="area_external_id" />
  <arg name="vessel_external_id" default="" />
  <arg name="uidss_dir" />
  <arg name="uv" default="uv" />
  <arg name="worker_poll_s" default="30" />
  <arg name="worker_command"
       default="$(arg uv) run --project $(arg uidss_dir) dss worker --area $(arg area_external_id) --poll $(arg worker_poll_s)" />
  <arg name="config" default="$(find autoassess_bridge)/config/autoassess_bridge.yaml" />
  <arg name="odometry_topic" default="odometry" />

  <include file="$(find autoassess_bridge)/launch/autoassess_bridge.launch">
    <arg name="area_external_id" value="$(arg area_external_id)" />
    <arg name="vessel_external_id" value="$(arg vessel_external_id)" />
    <arg name="config" value="$(arg config)" />
    <arg name="odometry_topic" value="$(arg odometry_topic)" />
  </include>

  <!-- worker_node exits 2 with a clear message when the command has no `- -area <id>`;
       dss worker itself loops, respawn covers crashes/exits only. -->
  <node pkg="autoassess_bridge" type="worker_node" name="dss_worker" output="screen"
        respawn="true" respawn_delay="30" args="$(arg worker_command)" />
</launch>
