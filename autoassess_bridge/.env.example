# CDF credentials for autoassess_bridge. Copy to .env (git-ignored) and fill in:
#   cp autoassess_bridge/.env.example autoassess_bridge/.env
# Load before launching:
#   set -a; source autoassess_bridge/.env; set +a
#   roslaunch autoassess_bridge autoassess_bridge.launch area_external_id:=area-XXXX
# Docker: docker run --env-file autoassess_bridge/.env ...
# Ask the AutoAssess team for the values (the same five as the AutoAssess SDK's sdk/.env).
COGNITE_PROJECT=
COGNITE_CLUSTER=
# Azure AD tenant UUID, or the Cognite IdP organization name
COGNITE_TENANT_ID=
COGNITE_CLIENT_ID=
COGNITE_CLIENT_SECRET=
