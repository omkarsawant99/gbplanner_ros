<?xml version="1.0"?>
<package format="2">
  <name>autoassess_bridge</name>
  <version>0.1.0</version>
  <description>
    Polls AutoAssess inspection plans from Cognite Data Fusion (read-only) and publishes them
    (plan JSON, inspection target poses, optional global planning bound) to the autonomy stack.
  </description>

  <maintainer email="eliasbjorne@gmail.com">Elias Bjorne</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <buildtool_depend>python3-setuptools</buildtool_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>planner_msgs</exec_depend>
  <!-- cognite-sdk is not in rosdep: install it with pip3 install -r requirements.txt -->

  <test_depend>python3-pytest</test_depend>
</package>
